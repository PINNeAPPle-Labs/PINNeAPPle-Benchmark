# Raw/downloaded datasets: re-fetch with each experiment's own download script (see its README).
*/data/
# Smoke-test artifacts: not part of the reported results.
*/results_smoke/
# Model checkpoints: not needed to rebuild a paper (make_paper.py reads results.json + small .npz examples only).
*.pt
__pycache__/
*.pyc
.DS_Store
# Smoke-test data and figures (EXP09_SMOKE=1): not part of the reported results.
*/data_smoke/
*/figures_smoke/
# Prepared artifacts of the library benchmark: regenerated by `bench09.py prepare` (manifests, costs and checks are kept).
*/results/prepared/**/*.npz
*/results/prepared/airfoil/runs/
*/results/prepared/airfoil/ood/
*/results/prepared/airfoil/geometry/case_*/
*/results/prepared/airfoil/gci_case/
*/results/runs/*.ckpt.pt
